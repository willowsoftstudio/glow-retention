{% if block.settings.embed_layout == 'inline' %}
  {% assign is_inline = true %}
  {% assign modal_position_style = "position: relative; display: block; background: none; width: 100%; height: auto; box-shadow: none; z-index: 1;" %}

  {% case block.settings.columns_desktop %}
    {% when '1' %}
      {% assign max_card_width = "500px" %}
    {% when '2' %}
      {% assign max_card_width = "800px" %}
    {% when '3' %}
      {% assign max_card_width = "1100px" %}
  {% endcase %}

  {% assign card_container_style = "background-color: #fff; padding: 30px; border-radius: 12px; width: 100%; max-width: " | append: max_card_width | append: "; margin: 0 auto; box-shadow: none; border: 1px solid #e1e3e5; position: relative;" %}
  {% assign close_button_style = "display: none;" %}
  {% assign trigger_button_style = "display: none;" %}
{% else %}
  {% assign is_inline = false %}
  {% assign modal_position_style = "position: fixed; display: none; top: 0; left: 0; width: 100vw; height: 100vh; background-color: rgba(0, 0, 0, 0.6); z-index: 2147483647; align-items: center; justify-content: center; backdrop-filter: blur(4px);" %}
  {% assign card_container_style = "background-color: #fff; padding: 30px; border-radius: 16px; width: 90%; max-width: 500px; box-shadow: 0 20px 40px rgba(0,0,0,0.3); position: relative; max-height: 90vh; overflow-y: auto;" %}
  {% assign close_button_style = "display: block; position: absolute; top: 20px; right: 20px; background: none; border: none; font-size: 22px; cursor: pointer; color: #6d7175; font-weight: bold; transition: color 0.2s;" %}
  {% if block.settings.display_mode == 'popup' %}
    {% assign trigger_button_style = "display: none;" %}
  {% else %}
    {% assign trigger_button_style = "display: inline-block;" %}
  {% endif %}
{% endif %}

{% case block.settings.button_size %}
  {% when 'small' %}
    {% assign btn_padding = "10px 20px" %}
    {% assign btn_font_size = "14px" %}
  {% when 'medium' %}
    {% assign btn_padding = "14px 28px" %}
    {% assign btn_font_size = "16px" %}
  {% when 'large' %}
    {% assign btn_padding = "18px 36px" %}
    {% assign btn_font_size = "18px" %}
{% endcase %}

{% case block.settings.button_alignment %}
  {% when 'left' %}
    {% assign wrapper_alignment = "text-align: left;" %}
  {% when 'center' %}
    {% assign wrapper_alignment = "text-align: center;" %}
  {% when 'right' %}
    {% assign wrapper_alignment = "text-align: right;" %}
{% endcase %}

<div id="beauty-effect-block-container-{{ block.id }}" class="beauty-effect-block-root">

{% if is_inline == false and block.settings.display_mode != 'popup' %}
  <div class="beauty-quiz-trigger-wrapper" style="margin: 30px 0; {{ wrapper_alignment }} {{ trigger_button_style }} width: 100%;">
    <button id="beauty-quiz-trigger" style="
      padding: {{ btn_padding }};
      font-size: {{ btn_font_size }};
      background-color: {{ block.settings.button_bg_color | default: '#000000' }};
      color: {{ block.settings.button_text_color | default: '#ffffff' }};
      border: none;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      transition: transform 0.2s, opacity 0.2s;
    " onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
      ✨ Take Our AI Beauty Quiz
    </button>
  </div>
{% endif %}

<div id="beauty-quiz-modal" class="beauty-portal-container-wrapper" style="{{ modal_position_style }}" {{ block.shopify_attributes }} data-block-id="{{ block.id }}">
  <div class="beauty-quiz-card" style="{{ card_container_style }} font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">

    <button id="beauty-quiz-close" style="{{ close_button_style }}" onmouseover="this.style.color='#000'" onmouseout="this.style.color='#6d7175'">✕</button>

    <div class="beauty-quiz-header">
      <h2 style="margin-top: 0; margin-bottom: 8px; font-size: 22px; color: {{ block.settings.button_bg_color | default: '#000000' }}; font-weight: bold;">Discover Your Custom Beauty Ritual 💄</h2>
      <p style="margin: 0 0 20px 0; font-size: 14px; color: #6d7175; line-height: 1.4;">Tell us about your skin, hair, and lifestyle preferences. Our AI will curate your monthly subscription box with perfect-match ingredients!</p>
    </div>

    <div id="beauty-quiz-success-msg" class="beauty-quiz-success-alert" style="display: none;">
      🎉 <strong>Preferences Saved!</strong> Your profile has been updated in our AI curation engine. We've updated your next monthly box!
    </div>

    <div id="beauty-quiz-guest-view" style="display: none; text-align: center; padding: 20px 0;">
      <div style="font-size: 55px; margin-bottom: 16px; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));">✨💄🌿</div>
      <h2 style="margin-top: 0; margin-bottom: 12px; font-size: 22px; color: {{ block.settings.button_bg_color | default: '#000000' }}; font-weight: bold;">Unlock Your Curation Dashboard!</h2>
      <p style="margin: 0 0 24px 0; font-size: 14px; color: #6d7175; line-height: 1.5; text-align: left;">
        Sign in to submit your AI beauty profile! You will unlock:
      </p>
      <ul style="margin: 0 0 28px 0; padding-left: 20px; font-size: 14px; color: #4a5568; text-align: left; line-height: 1.7;">
        <li>✨ Personalized monthly product curation matching your precise skin & hair type.</li>
        <li>🚫 Allergen scanner to automatically screen out harmful or sensitive ingredients.</li>
        <li>📦 Smart subscription optimization to easily swap products and avoid wasted inventory.</li>
      </ul>
      <button id="beauty-guest-login-btn" type="button" style="
        width: 100%;
        padding: 14px;
        background-color: {{ block.settings.button_bg_color | default: '#000000' }};
        color: {{ block.settings.button_text_color | default: '#ffffff' }};
        border: none;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        font-size: 16px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: opacity 0.2s;
      " onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">🐾 Sign In / Create Account</button>
    </div>

    <form id="beauty-quiz-form" onsubmit="submitBeautyQuiz(event)">

      <div class="beauty-quiz-section">
        <h3 style="margin-top: 0; margin-bottom: 12px; font-size: 15px; font-weight: 600; color: #1c1d1f; border-bottom: 1px solid #f1f2f4; padding-bottom: 8px;">✨ 1. Skin & Fragrance Profile</h3>

        <div class="beauty-quiz-fields-grid columns-{{ block.settings.columns_desktop | default: '1' }}">
          <div class="form-group">
            <label for="beauty-skin-type">Skin Type</label>
            <select id="beauty-skin-type" name="skinType" required>
              <option value="dry">Dry / Dehydrated</option>
              <option value="oily">Oily / Acne-Prone</option>
              <option value="sensitive">Sensitive / Redness-Prone</option>
              <option value="combination" selected>Combination</option>
            </select>
          </div>

          <div class="form-group" style="grid-column: span {{ block.settings.columns_desktop | default: '1' }};">
            <label for="beauty-skin-concerns">Primary Skin Concerns (Select all that apply)</label>
            <div class="checkbox-grid">
              <label class="checkbox-label"><input type="checkbox" name="concerns" value="aging"> Anti-Aging</label>
              <label class="checkbox-label"><input type="checkbox" name="concerns" value="acne"> Acne & Blemishes</label>
              <label class="checkbox-label"><input type="checkbox" name="concerns" value="dryness" checked> Dryness & Dehydration</label>
              <label class="checkbox-label"><input type="checkbox" name="concerns" value="redness"> Redness & Sensitivity</label>
              <label class="checkbox-label"><input type="checkbox" name="concerns" value="dullness"> Dullness & Dark Spots</label>
            </div>
          </div>

          <div class="form-group">
            <label for="beauty-fragrance">Fragrance Preference</label>
            <select id="beauty-fragrance" name="fragrancePreference" required>
              <option value="floral">Floral / Sweet</option>
              <option value="citrus" selected>Citrus / Fresh</option>
              <option value="none">Unscented / No Fragrance</option>
            </select>
          </div>

          <div class="form-group">
            <label for="beauty-price">Budget / Price Sensitivity</label>
            <select id="beauty-price" name="priceSensitivity" required>
              <option value="low">Value-Driven (Low)</option>
              <option value="medium" selected>Balanced (Medium)</option>
              <option value="high">Luxury / Premium (High)</option>
            </select>
          </div>
        </div>
      </div>

      <div class="beauty-quiz-section" style="border-bottom: none; margin-bottom: 10px;">
        <h3 style="margin-top: 0; margin-bottom: 12px; font-size: 15px; font-weight: 600; color: #1c1d1f; border-bottom: 1px solid #f1f2f4; padding-bottom: 8px;">🌿 2. Personalization & Lifestyle Preferences</h3>

        <div class="beauty-quiz-fields-grid columns-{{ block.settings.columns_desktop | default: '1' }}">
          <div class="form-group">
            <label for="beauty-categories">Preferred Product Categories</label>
            <select id="beauty-categories" name="preferredCategories" required>
              <option value="skincare">Skincare Only</option>
              <option value="makeup">Makeup Only</option>
              <option value="haircare">Haircare Only</option>
              <option value="all" selected>A Mix of Everything</option>
            </select>
          </div>

          <div class="form-group">
            <label for="beauty-ethical">Ethical & Ingredient Preferences</label>
            <select id="beauty-ethical" name="ethicalPreferences" required>
              <option value="cruelty-free" selected>Cruelty-Free</option>
              <option value="vegan">Vegan Only</option>
              <option value="organic">Clean / Organic Only</option>
              <option value="none">No Restrictions</option>
            </select>
          </div>

          <div class="form-group">
            <label for="beauty-hair">Hair Type & Texture</label>
            <select id="beauty-hair" name="hairType" required>
              <option value="straight">Fine & Straight</option>
              <option value="wavy" selected>Wavy / Textured</option>
              <option value="curly">Curly</option>
              <option value="coily">Coily / Textured</option>
              <option value="none">Do not include Hair Products</option>
            </select>
          </div>

          <div class="form-group">
            <label for="beauty-climate">Primary Local Climate</label>
            <select id="beauty-climate" name="localClimate" required>
              <option value="arid">Arid / Dry</option>
              <option value="humid">Humid / Tropical</option>
              <option value="temperate" selected>Temperate / Seasonal</option>
              <option value="cold">Cold / Dry</option>
            </select>
          </div>

          <div class="form-group" style="grid-column: span {{ block.settings.columns_desktop | default: '1' }};">
            <label for="beauty-zipcode">Zip / Postal Code</label>
            <input type="text" id="beauty-zipcode" name="zipCode" placeholder="e.g. 90210" style="width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #c9cccf; font-size: 14px; box-sizing: border-box;">
            <p style="margin: 4px 0 0 0; font-size: 11px; color: #6d7175; line-height: 1.3;">Used to dynamically analyze local weather, UV indexes, and humidity to auto-tune your skincare formulation.</p>
          </div>

          <div class="form-group" style="grid-column: span {{ block.settings.columns_desktop | default: '1' }};">
            <label for="beauty-allergens">Ingredient Allergens / Exclusions</label>
            <div id="beauty-allergens-tag-container" style="display: flex; flex-wrap: wrap; gap: 6px; padding: 6px 10px; border: 1px solid #c9cccf; border-radius: 6px; background-color: #ffffff; min-height: 42px; box-sizing: border-box; cursor: text; align-items: center;">
              <span id="beauty-allergens-chips" style="display: flex; flex-wrap: wrap; gap: 6px;"></span>
              <input type="text" id="beauty-allergens-input" placeholder="Type allergen and press comma or Enter" style="border: none; outline: none; padding: 4px 0; font-size: 14px; flex-grow: 1; min-width: 150px; background: transparent;">
            </div>
            <p style="margin: 4px 0 0 0; font-size: 11px; color: #6d7175; line-height: 1.3;">We will strictly scan and block any products with matching ingredients from being curated in your boxes.</p>
          </div>
        </div>
      </div>

      <button type="submit" id="beauty-submit-btn" class="beauty-quiz-submit-btn" style="
        background-color: {{ block.settings.button_bg_color | default: '#000000' }};
        color: {{ block.settings.button_text_color | default: '#ffffff' }};
      ">✨ Save My Beauty Profile</button>
    </form>
  </div>
</div>
</div>

<style>
  .beauty-tag-chip {
    display: inline-flex;
    align-items: center;
    background-color: #f1f2f4;
    color: #202223;
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
    gap: 4px;
    border: 1px solid #e1e3e5;
  }
  .beauty-tag-chip-remove {
    cursor: pointer;
    font-weight: bold;
    color: #6d7175;
    font-size: 14px;
    line-height: 1;
    transition: color 0.15s;
  }
  .beauty-tag-chip-remove:hover {
    color: #ff0000;
  }

  .beauty-quiz-fields-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 768px) {
    .beauty-quiz-fields-grid.columns-2 {
      grid-template-columns: repeat(2, 1fr);
    }
    .beauty-quiz-fields-grid.columns-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .beauty-quiz-card {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #202223;
    animation: beautySlideIn 0.3s ease-out;
  }
  @keyframes beautySlideIn {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  .beauty-quiz-section {
    margin-bottom: 20px;
    padding-bottom: 15px;
  }
  .form-group {
    margin-bottom: 14px;
    text-align: left;
  }
  .form-group label {
    display: block;
    font-weight: 600;
    font-size: 12px;
    margin-bottom: 5px;
    color: #202223;
  }
  .form-group select {
    width: 100%;
    padding: 10px;
    border-radius: 6px;
    border: 1px solid #c9cccf;
    font-size: 14px;
    background-color: #ffffff;
    box-sizing: border-box;
  }
  .checkbox-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 8px;
    background: #f6f6f7;
    padding: 10px;
    border-radius: 6px;
  }
  .checkbox-label {
    display: flex;
    align-items: center;
    font-size: 12px;
    cursor: pointer;
    font-weight: normal;
  }
  .checkbox-label input {
    margin-right: 6px;
  }
  .beauty-quiz-submit-btn {
    width: 100%;
    border: none;
    padding: 12px;
    font-size: 15px;
    font-weight: bold;
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    transition: transform 0.2s, opacity 0.2s;
  }
  .beauty-quiz-submit-btn:hover {
    opacity: 0.9;
  }
  .beauty-quiz-success-alert {
    background-color: #e2f1e8;
    color: #1e5128;
    border: 1px solid #b8dfc4;
    padding: 12px;
    border-radius: 6px;
    font-size: 13px;
    margin-bottom: 18px;
    text-align: center;
  }
</style>

<script>
  (function() {

    const oldModal = document.querySelector('body > #beauty-quiz-modal[data-block-id="{{ block.id }}"]');
    if (oldModal) {
      oldModal.remove();
    }

    const blockContainer = document.getElementById("beauty-effect-block-container-{{ block.id }}");
    const trigger = document.getElementById("beauty-quiz-trigger");
    const modal = document.getElementById("beauty-quiz-modal");
    const closeBtn = document.getElementById("beauty-quiz-close");
    const form = document.getElementById("beauty-quiz-form");
    const successMsg = document.getElementById("beauty-quiz-success-msg");

    const embedLayout = "{{ block.settings.embed_layout }}";
    const displayMode = "{{ block.settings.display_mode }}";
    const popupDelay = {{ block.settings.popup_delay | default: 3 }} * 1000;

    const isCustomerLoggedIn = {% if customer %}true{% else %}false{% endif %};
    const guestView = document.getElementById("beauty-quiz-guest-view");
    const guestLoginBtn = document.getElementById("beauty-guest-login-btn");

    if (!isCustomerLoggedIn) {
      if (form) form.style.display = "none";
      if (guestView) guestView.style.display = "block";
      if (guestLoginBtn) {
        guestLoginBtn.addEventListener("click", () => {
          window.location.href = "/account/login?checkout_url=" + encodeURIComponent(window.location.href);
        });
      }
    } else {
      if (form) form.style.display = "block";
      if (guestView) guestView.style.display = "none";

      (function() {
        const customerId = "gid://shopify/Customer/{{ customer.id }}";
        const shopDomain = "{{ shop.permanent_domain }}";
        const backendApiUrl = "{{ block.settings.api_url | default: 'https://glow-retention-git-develop-willowsoftstudio-5437s-projects.vercel.app' }}";

        fetch(backendApiUrl + "/api/storefront/customer-profile?customerId=" + encodeURIComponent(customerId) + "&shop=" + encodeURIComponent(shopDomain), {
          headers: {
            "x-test-session-id": "beauty-portal-session",
            "x-shop-domain": shopDomain
          }
        })
        .then(res => res.json())
        .then(data => {
          if (data && data.profile) {
            const prof = data.profile;
            console.log("[Glow Retention] Auto-hydrating customer skincare preferences:", prof);

            if (prof.skinType) document.getElementById("beauty-skin-type").value = prof.skinType;
            if (prof.fragrancePreference) document.getElementById("beauty-fragrance").value = prof.fragrancePreference;
            if (prof.priceSensitivity) document.getElementById("beauty-price").value = prof.priceSensitivity;
            if (prof.preferredCategories && prof.preferredCategories[0]) document.getElementById("beauty-categories").value = prof.preferredCategories[0];
            if (prof.ethicalPreferences && prof.ethicalPreferences[0]) document.getElementById("beauty-ethical").value = prof.ethicalPreferences[0];
            if (prof.hairType) document.getElementById("beauty-hair").value = prof.hairType;
            if (prof.localClimate) document.getElementById("beauty-climate").value = prof.localClimate;
            if (prof.zipCode) document.getElementById("beauty-zipcode").value = prof.zipCode;

            if (prof.concerns) {
              prof.concerns.forEach(concern => {
                const cb = document.querySelector('input[name="concerns"][value="' + concern + '"]');
                if (cb) cb.checked = true;
              });
            }

            if (prof.allergens) {
              window.beautyAllergensList = prof.allergens;
              if (typeof renderAllergensChips === "function") {
                renderAllergensChips();
              }
            }

            const portalUrl = backendApiUrl + "/api/storefront/portal/view?customerId=" + encodeURIComponent(customerId) + "&shop=" + encodeURIComponent(shopDomain);
            const portalBanner = document.createElement("div");
            portalBanner.style.background = "linear-gradient(135deg, #f0f4ff 0%, #e2e8f0 100%)";
            portalBanner.style.border = "1px solid #cbd5e0";
            portalBanner.style.padding = "14px";
            portalBanner.style.borderRadius = "8px";
            portalBanner.style.marginBottom = "20px";
            portalBanner.style.textAlign = "center";

            let tierLabel = "STARTER Box ($30/mo)";
            if (prof.subscription && prof.subscription.tier === "PRO") tierLabel = "PRO Box ($60/mo)";
            if (prof.subscription && prof.subscription.tier === "ENTERPRISE") tierLabel = "ENTERPRISE Box ($120/mo)";

            portalBanner.innerHTML = '<div style="font-weight: bold; font-size: 14px; color: #2c3e50; margin-bottom: 6px;">✨ Your Glow Subscription Active</div>' +
              '<div style="font-size: 12px; color: #4a5568; margin-bottom: 10px;">Active Routine: <strong>' + tierLabel + '</strong></div>' +
              '<a href="' + portalUrl + '" target="_blank" style="display: inline-block; padding: 8px 16px; background-color: #2b6cb0; color: #fff; border-radius: 6px; font-weight: bold; text-decoration: none; font-size: 13px;">📱 Manage Subscription Routine Portal</a>';

            const formHeader = document.querySelector("#beauty-quiz-form h3") || form.firstChild;
            if (formHeader) {
              formHeader.parentNode.insertBefore(portalBanner, formHeader.nextSibling);
            }
          }
        })
        .catch(err => console.error("[Glow Retention] Failed to pre-fill customer profile:", err));
      })();
    }

    if (modal) {
      if (embedLayout === "inline") {
        if (blockContainer && modal.parentNode !== blockContainer) {
          blockContainer.appendChild(modal);
        }
      } else {
        if (modal.parentNode !== document.body) {
          document.body.appendChild(modal);
        }
      }
    }

    window.beautyAllergensList = [];

    const tagContainer = document.getElementById("beauty-allergens-tag-container");
    const chipsWrapper = document.getElementById("beauty-allergens-chips");
    const tagInput = document.getElementById("beauty-allergens-input");

    function renderAllergensChips() {
      if (!chipsWrapper) return;
      chipsWrapper.innerHTML = window.beautyAllergensList.map((tag, idx) => `
        <span class="beauty-tag-chip" data-idx="${idx}">
          ${tag}
          <span class="beauty-tag-chip-remove" onclick="removeAllergenTag(${idx})">&times;</span>
        </span>
      `).join("");
    }

    window.removeAllergenTag = function(idx) {
      window.beautyAllergensList.splice(idx, 1);
      renderAllergensChips();
    };

    function addAllergenFromInput() {
      if (!tagInput) return;
      let val = tagInput.value.trim().toLowerCase();
      if (val.endsWith(",")) {
        val = val.substring(0, val.length - 1).trim();
      }
      if (val && !window.beautyAllergensList.includes(val)) {
        window.beautyAllergensList.push(val);
        renderAllergensChips();
      }
      tagInput.value = "";
    }

    if (tagContainer && tagInput) {
      tagContainer.addEventListener("click", () => {
        tagInput.focus();
      });

      tagInput.addEventListener("keydown", (ev) => {
        if (ev.key === "Enter" || ev.key === ",") {
          ev.preventDefault();
          addAllergenFromInput();
        } else if (ev.key === "Backspace" && tagInput.value === "" && window.beautyAllergensList.length > 0) {
          window.beautyAllergensList.pop();
          renderAllergensChips();
        }
      });

      tagInput.addEventListener("blur", () => {
        addAllergenFromInput();
      });
    }

    if (embedLayout !== "inline") {
      if (modal && modal.parentNode !== document.body) {
        document.body.appendChild(modal);
      }
    }

    document.addEventListener("click", (ev) => {
      const targetElement = ev.target.closest("#beauty-quiz-trigger, .beauty-quiz-trigger, a[href='#beauty-quiz'], a[href='#beauty-quiz-trigger']");
      if (targetElement && embedLayout !== "inline") {
        ev.preventDefault();
        ev.stopPropagation();

        if (modal) {
          modal.style.display = "flex";
          document.body.style.overflow = "hidden";
        }
      }
    });

    if (closeBtn && embedLayout !== "inline") {
      closeBtn.addEventListener("click", () => {
        if (modal) modal.style.display = "none";
        document.body.style.overflow = "auto";
        sessionStorage.setItem("beauty-quiz-closed", "true");
      });
    }

    if (embedLayout !== "inline" && (displayMode === "popup" || displayMode === "both")) {
      setTimeout(() => {
        if (!modal) return;
        const hasClosedQuiz = sessionStorage.getItem("beauty-quiz-closed") === "true";
        const isDesignMode = window.Shopify && window.Shopify.designMode;

        if (modal.style.display !== "flex" && (!hasClosedQuiz || isDesignMode)) {
          modal.style.display = "flex";
          document.body.style.overflow = "hidden";
        }
      }, popupDelay);
    }

    if (embedLayout !== "inline") {
      document.addEventListener("shopify:block:select", (event) => {
        if (event.detail.blockId === "{{ block.id }}" && modal) {
          modal.style.display = "flex";
          document.body.style.overflow = "hidden";
        }
      });
      document.addEventListener("shopify:block:deselect", (event) => {
        if (event.detail.blockId === "{{ block.id }}" && modal) {
          modal.style.display = "none";
          document.body.style.overflow = "auto";
        }
      });
    }
  })();

  function submitBeautyQuiz(event) {
    event.preventDefault();

    const form = document.getElementById("beauty-quiz-form");
    const submitBtn = document.getElementById("beauty-submit-btn");
    const successMsg = document.getElementById("beauty-quiz-success-msg");

    const shopDomain = "{{ shop.permanent_domain }}";
    const customerId = "{% if customer %}gid://shopify/Customer/{{ customer.id }}{% else %}guest_visitor{% endif %}";
    const customerEmail = "{% if customer %}{{ customer.email }}{% else %}visitor@anonymous.com{% endif %}";
    const customerName = "{% if customer %}{{ customer.name | escape }}{% else %}Storefront Visitor{% endif %}";

    const backendApiUrl = "{{ block.settings.api_url | default: 'https://glow-retention-git-develop-willowsoftstudio-5437s-projects.vercel.app' }}";

    const checkedConcerns = [];
    document.querySelectorAll('input[name="concerns"]:checked').forEach((cb) => {
      checkedConcerns.push(cb.value);
    });

    const payload = {
      customerId: customerId,
      name: customerName,
      email: customerEmail,
      skinType: document.getElementById("beauty-skin-type").value,
      concerns: checkedConcerns,
      fragrancePreference: document.getElementById("beauty-fragrance").value,
      priceSensitivity: document.getElementById("beauty-price").value,
      preferredCategories: [document.getElementById("beauty-categories").value],
      ethicalPreferences: [document.getElementById("beauty-ethical").value],
      hairType: document.getElementById("beauty-hair").value,
      localClimate: document.getElementById("beauty-climate").value,
      zipCode: document.getElementById("beauty-zipcode").value,
      allergens: window.beautyAllergensList || []
    };

    submitBtn.disabled = true;
    submitBtn.innerText = "⏳ Saving Profile...";

    fetch(backendApiUrl + "/api/storefront/customer-profiles", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "x-test-session-id": "beauty-portal-session",
        "x-shop-domain": shopDomain
      },
      body: JSON.stringify(payload)
    })
      .then(res => {
        if (!res.ok) {
          return res.json().then((err) => { throw new Error(err.message || "Failed to submit"); });
        }
        return res.json();
      })
      .then(data => {
        successMsg.style.display = "block";
        submitBtn.innerText = "✨ Save My Beauty Profile";
        submitBtn.disabled = false;

        successMsg.scrollIntoView({ behavior: "smooth", block: "center" });

        setTimeout(() => {
          successMsg.style.display = "none";
        }, 6000);
      })
      .catch(err => {
        alert("🔒 Submission Error: " + err.message);
        submitBtn.innerText = "✨ Save My Beauty Profile";
        submitBtn.disabled = false;
      });
  }
</script>

