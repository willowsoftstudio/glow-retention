datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../web/backend/prisma-client"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  isPremium           Boolean   @default(false)
  plan                String    @default("STARTER") // "STARTER", "PRO", "ENTERPRISE"
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean?
  locale              String?
  collaborator        Boolean?
  emailVerified       Boolean?
  refreshToken        String?
  refreshTokenExpires DateTime?
  boxPriceLow         Float     @default(30.0)
  boxPriceMedium      Float     @default(60.0)
  boxPriceHigh        Float     @default(120.0)
  targetMargin        Float     @default(55.0)
  milestoneOrderCount Int       @default(3)
  giftVariantIds      String    @default("[]")
  enableSafetyGuard   Boolean   @default(true)
  themeSettingsJson   String?
}

model CustomerProfile {
  id                  String              @id @default(uuid())
  customerId          String              // Shopify Customer GID
  shop                String              // Associated merchant shop domain
  name                String?
  email               String?
  phone               String?             // Subscriber mobile phone number
  skinType            String?             // e.g., "dry", "oily", "sensitive"
  concerns            String[]            // e.g., ["acne", "aging", "redness"]
  fragrancePreference String?             // e.g., "floral", "none"
  priceSensitivity    String?             // e.g., "high", "medium", "low"
  preferredCategories String[]            // e.g., ["skincare", "haircare", "makeup"]
  ethicalPreferences  String[]            // e.g., ["vegan", "cruelty-free"]
  hairType            String?             // e.g., "straight", "curly"
  localClimate        String?             // e.g., "dry", "humid"
  zipCode             String?             // Postal code for weather climate API lookups
  allergens           String[]            // Strictly filtered-out ingredients
  smsOptOut           Boolean             @default(false) // Legal TCPA compliance opt-out flag
  magicLinkToken      String?
  magicLinkExpires    DateTime?
  glowPoints          Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  subscription        SubscriptionData?
  churnRisk           ChurnRisk?
  retentionWorkflows  RetentionWorkflow[]
  referrals           Referral[]          @relation("Referrer")

  @@index([customerId])
  @@index([shop])
}

model SubscriptionData {
  id                 String          @id @default(uuid())
  customerProfileId  String          @unique
  customerProfile    CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  status             String          @default("ACTIVE") // "ACTIVE", "PAUSED", "CANCELLED"
  tier               String          @default("STARTER") // "STARTER", "PRO", "ENTERPRISE"
  skipCount          Int             @default(0)
  pauseCount         Int             @default(0)
  failedPaymentCount Int             @default(0) // Failed payments count for dunning
  tenureMonths       Int             @default(1) // Number of months of active subscription
  deliveredProductIds String[]        // List of historically delivered product GIDs to prevent duplicate saturation
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model ChurnRisk {
  id                String          @id @default(uuid())
  customerProfileId String          @unique
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  riskScore         Float           @default(0.0) // 0 to 100
  flaggedReasons    String[]        // e.g., ["skipped last 2 boxes", "low email engagement"]
  status            String          @default("LOYAL") // "AT_RISK", "LOYAL", "DORMANT", "HIGH_VALUE"
  calculatedAt      DateTime        @default(now())
}

model RetentionWorkflow {
  id                String          @id @default(uuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  templateName      String          // e.g., "We miss you", "Early skip incentive"
  status            String          @default("SENT") // "SENT", "OPENED", "CLICKED", "CONVERTED"
  offerApplied      String?         // e.g., "10% off"
  triggeredAt       DateTime        @default(now())

  @@index([customerProfileId])
}

model BoxCuration {
  id               String      @id @default(uuid())
  subscriptionTier String      // "STARTER", "PRO", "ENTERPRISE"
  boxMonth         String      // e.g., "2026-09"
  customerId       String?
  customerName     String?
  totalPrice       Float       @default(0.0)
  targetPrice      Float       @default(0.0)
  suggestedItems   Json        // Array of suggested items { variantId, score, reason }
  acceptedItems    Json?       // Array of chosen items { variantId }
  status           String      @default("SUGGESTED") // "SUGGESTED", "ACCEPTED", "SHIPPED"
  margin           Float?
  createdAt        DateTime    @default(now())
}

model InventoryAnalytics {
  id             String      @id @default(uuid())
  productId      String      @unique // Shopify Product GID
  retentionValue Float       @default(0.0) // Percentage of customers reordering
  returnRate     Float       @default(0.0)
  satisfaction   Float       @default(0.0) // Avg product rating
  margin         Float       @default(0.0)
  price          Float       @default(15.0)
  cost           Float       @default(6.0)
  stockLevel     Int         @default(0)
  stockRisk      String      @default("LOW") // "LOW", "MEDIUM", "HIGH"
  updatedAt      DateTime    @updatedAt
}

model Referral {
  id                String          @id @default(uuid())
  referrerId        String
  referrer          CustomerProfile @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  friendName        String?
  status            String          @default("SENT") // "SENT", "CONVERTED"
  rewardStatus      String          @default("PENDING") // "PENDING", "CLAIMED"
  createdAt         DateTime        @default(now())

  @@index([referrerId])
}

model SubscriptionContract {
  id              String   @id // Shopify Subscription Contract GID
  shop            String
  customerId      String   // Shopify Customer GID
  status          String   // ACTIVE, PAUSED, CANCELLED
  nextBillDate    DateTime
  frequencyDays   Int      @default(30)
  items           String   @default("[]") // JSON string of subscription items
  ordersCompleted Int      @default(0)    // Tracks milestone completion
  abSegment       String   @default("A")  // For split tests (e.g. "A" / "B")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AbExperiment {
  id         String   @id @default(uuid())
  shop       String
  name       String   // e.g. "Dry Skin Cancel Test"
  treatmentA String   // e.g. "FREE_GIFT"
  treatmentB String   // e.g. "PERCENT_DISCOUNT"
  savesA     Int      @default(0)
  savesB     Int      @default(0)
  cancelsA   Int      @default(0)
  cancelsB   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
