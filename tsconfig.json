{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "types": ["node", "vitest"],
    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["./web/backend/prisma-client"]
    }
  },
  "include": ["web/**/*.ts", "extensions/**/*.ts", "tests/**/*.ts"]
}
